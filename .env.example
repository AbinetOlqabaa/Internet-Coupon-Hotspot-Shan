# Runtime Environment
NODE_ENV="development"
PORT="3000"
APP_URL="https://ais-dev-4pch7e7go4rvcwe5nzng64-364100045543.europe-west2.run.app"
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# AI Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Security & Initial Administrator Provisioning
# Email and initial password for the primary SUPER_ADMIN
INITIAL_ADMIN_EMAIL="superadmin@gmail.com"
INITIAL_ADMIN_PASSWORD="YourStrongPasswordHere"
# Optional secret token required to execute POST /api/v1/admin/bootstrap when system has zero admins
ADMIN_BOOTSTRAP_TOKEN="your_secure_bootstrap_token_here"

# Payment & Webhook Security
# HMAC-SHA256 signature secret for verifying incoming payment callbacks
WEBHOOK_SECRET="change_me_to_strong_random_secret_in_production"

# Production PostgreSQL Persistence (Optional: defaults to in-memory repository layer)
# DATABASE_URL="postgresql://hotspot_user:secure_password@localhost:5432/hotspot_db"

